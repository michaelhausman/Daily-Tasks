# Copy to .env.local for local overrides, or set these in your host's dashboard.
# Every value here is OPTIONAL for local development — with none of them set,
# the app runs on embedded Postgres and local disk, no accounts required.


# ─── Database ────────────────────────────────────────────────────────────────
# Unset  -> PGlite, real Postgres compiled to WASM, stored in .data/pg.
#           Zero setup. This is what `npm run dev` uses out of the box.
# Set    -> a real Postgres server. Required in production.
#
# DATABASE_URL=postgres://user:password@host:5432/tagpool?sslmode=require

# Max pooled connections. Lower it if your provider caps connections
# (Supabase's direct port and Neon's unpooled endpoint are both easy to exhaust
# — prefer their pooled/PgBouncer connection string instead).
# DATABASE_POOL_MAX=10


# ─── Object storage ──────────────────────────────────────────────────────────
# Unset  -> local disk under .data/media. Fine locally, wrong in production:
#           most hosts have ephemeral filesystems, so uploads vanish on deploy.
# "s3"   -> any S3-compatible bucket. Required in production.
#
# STORAGE_DRIVER=s3
# S3_BUCKET=tagpool-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Cloudflare R2 (recommended — no egress charges, which dominate a video site's
# bill). Find the account ID in your Cloudflare dashboard URL.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto

# Amazon S3
# S3_REGION=us-east-1
# (leave S3_ENDPOINT unset — the SDK derives it from the region)

# Backblaze B2
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# S3_REGION=us-west-004

# MinIO or another self-hosted gateway
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true


# ─── Serving media ───────────────────────────────────────────────────────────
# Unset  -> media is proxied through the app at /api/files/<key>. Works
#           everywhere, but every byte of every video crosses your server.
# Set    -> URLs point straight at your CDN or public bucket and the app stops
#           touching media bytes at all. Strongly recommended once you have
#           real traffic. Must serve the same key layout: <base>/media/<id>/...
#
# MEDIA_PUBLIC_BASE_URL=https://media.yourdomain.com


# ─── Paths (rarely needed) ───────────────────────────────────────────────────
# PGLITE_DIR=.data/pg
# STORAGE_ROOT=.data/media
